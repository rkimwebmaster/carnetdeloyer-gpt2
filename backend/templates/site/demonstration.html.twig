<section role="tabpanel" id="vue-biens" aria-labelledby="onglet-biens" tabindex="0" data-panel="biens" hidden><span class="eyebrow">VOTRE PATRIMOINE</span><h1>Mes biens<span>.</span></h1><p>Trois propriétés fictives pour explorer l’organisation de votre espace.</p><div class="demo-properties">{% for bien in [['Résidence Gombe','Kinshasa · Gombe','3 unités · 2 louées'],['Maison Les Jardins','Kinshasa · Ngaliema','1 unité · louée'],['Galerie du Centre','Kinshasa · Limete','2 unités · louées']] %}<article class="feature-card"><span class="feature-icon">⌂</span><h2 class="card-heading">{{ bien[0] }}</h2><p>{{ bien[1] }}</p><span class="badge neutral">{{ bien[2] }}</span></article>{% endfor %}</div></section>
<section role="tabpanel" id="vue-contrats" aria-labelledby="onglet-contrats" tabindex="0" data-panel="contrats" hidden><span class="eyebrow">LES CONDITIONS, BIEN RANGÉES</span><h1>Contrats<span>.</span></h1><p>Exemples de contrats en cours. Les noms et montants sont fictifs.</p><div class="table-scroll"><table><caption class="sr-only">Contrats de démonstration</caption><thead><tr><th>Unité</th><th>Locataire fictif</th><th>Loyer mensuel</th><th>Statut</th></tr></thead><tbody><tr><td>Appartement A1</td><td>Marie L.</td><td>300 USD</td><td><span class="badge success">Actif</span></td></tr><tr><td>Maison Les Jardins</td><td>Paul K.</td><td>450 USD</td><td><span class="badge success">Actif</span></td></tr><tr><td>Boutique B2</td><td>Sarah M.</td><td>200 USD</td><td><span class="badge success">Actif</span></td></tr></tbody></table></div></section>
