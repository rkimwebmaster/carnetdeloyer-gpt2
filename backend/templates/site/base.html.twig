<!doctype html>
<html lang="fr" data-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light dark">
    <meta name="description" content="CarnetDeLoyer rassemble vos biens, contrats, échéances et reçus dans un même espace. Découvrez une gestion locative plus sereine.">
    <title>{% block title %}CarnetDeLoyer · Vos locations, l’esprit tranquille{% endblock %}</title>
    {% set fichiers = app.request.basePath ~ '/site' %}
    <link rel="icon" type="image/png" href="{{ fichiers }}/logo.png">
    <link rel="stylesheet" href="{{ fichiers }}/site.css?v=2">
    <link rel="stylesheet" href="{{ fichiers }}/vitrine.css?v=2">
    <script src="{{ fichiers }}/site.js?v=2" defer></script>
    <script src="{{ fichiers }}/auth.js?v=2" defer></script>
</head>
<body data-page="{{ page }}" data-api-url="{{ app.request.baseUrl }}/api/v1" data-espace-url="{{ path('site_espace') }}" data-connexion-url="{{ path('site_connexion') }}">
<a class="skip" href="#contenu">Aller au contenu</a>
<div class="utility-bar"><div class="container"><span>Votre carnet de loyer passe au digital.</span><div><a href="{{ path('site_accueil') }}#questions">Besoin d’aide ?</a><span>FR · Français</span></div></div></div>
<header class="header">
    <div class="container header-inner">
        <a class="brand" href="{{ path('site_accueil') }}" aria-label="CarnetDeLoyer, accueil"><img src="{{ fichiers }}/logo.png" alt="" width="40" height="40"><span>Carnet<span class="brand-accent">DeLoyer</span><small>CHAQUE LOYER A SON HISTOIRE.</small></span></a>
        <button class="icon-button menu-toggle" aria-expanded="false" aria-controls="navigation" aria-label="Ouvrir le menu">☰</button>
        <nav id="navigation" aria-label="Navigation principale">
            {% for cle, titre in {'accueil':'Accueil', 'fonctionnalites':'Fonctionnalités', 'tarifs':'Tarifs', 'market':'Market', 'hotels':'Hôtels'} %}
                <a href="{{ path('site_' ~ cle) }}" {% if page == cle %}aria-current="page"{% endif %}>{{ titre }}</a>
            {% endfor %}
        </nav>
        <div class="header-actions"><button class="icon-button" data-theme-toggle aria-label="Activer le thème sombre" title="Changer de thème">◐</button><a class="login-link" href="{{ path('site_connexion') }}">Se connecter</a><a class="button small" href="{{ path('site_inscription') }}">Commencer <span aria-hidden="true">↗</span></a></div>
    </div>
</header>
<main id="contenu">{% block content %}{% endblock %}</main>
<footer class="footer">
    <div class="container footer-grid">
        <div><a class="brand" href="{{ path('site_accueil') }}"><img src="{{ fichiers }}/logo.png" alt="" width="36" height="36"><span>Carnet<span class="brand-accent">DeLoyer</span></span></a><p>Des locations bien suivies.<br>Des relations plus sereines.</p></div>
        <div><strong>La solution</strong><a href="{{ path('site_fonctionnalites') }}">Fonctionnalités</a><a href="{{ path('site_tarifs') }}">Tarifs transparents</a><a href="{{ path('site_demonstration') }}">Explorer la démo</a></div>
        <div><strong>À découvrir</strong><a href="{{ path('site_market') }}">Market immobilier</a><a href="{{ path('site_hotels') }}">Vitrine Hôtels</a><a href="{{ path('site_connexion') }}">Mon espace</a></div>
        <div class="footer-note"><span class="eyebrow">UNE GESTION QUI VOUS RESSEMBLE</span><p>Bailleurs et locataires,<br>avançons sur la même page.</p><a class="text-link" href="{{ path('site_inscription') }}">Rejoindre CarnetDeLoyer →</a></div>
    </div>
    <div class="container footer-bottom"><span>© {{ 'now'|date('Y') }} CarnetDeLoyer</span><a href="{{ app.request.baseUrl }}/confidentialite">Confidentialité</a><span>Fait pour simplifier la location.</span></div>
</footer>
</body>
</html>
