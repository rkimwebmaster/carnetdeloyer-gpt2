{% extends 'site/base.html.twig' %}
{% block title %}{{ inscription ? 'Inscription' : 'Connexion' }} · CarnetDeLoyer{% endblock %}
{% block content %}
<section class="container auth-layout"><div class="auth-story"><span class="hero-kicker">VOTRE CARNET PASSE AU DIGITAL.</span><h1>Vos locations.<br>Votre espace.<br><span>Votre tranquillité.</span></h1><p>Retrouvez le fil de vos biens et de vos loyers, où que vous soyez.</p><img class="auth-person" src="{{ fichiers }}/images/{{ inscription ? 'maman_bailleur.png' : 'monsieur_bailleur.png' }}" alt="Un utilisateur de CarnetDeLoyer consulte son téléphone"></div><div class="auth-card" data-auth>
<a class="text-link auth-back" href="{{ path('site_accueil') }}">← Retour à l’accueil</a><span class="auth-step" data-auth-step>ÉTAPE 1 SUR 2</span><h2 data-auth-title>{{ inscription ? 'Bienvenue chez vous.' : 'Heureux de vous retrouver.' }}</h2><p data-auth-description>{{ inscription ? 'Créez votre espace avec votre numéro de téléphone.' : 'Connectez-vous simplement, sans mot de passe.' }}</p>
{% if app.environment == 'dev' %}<div class="dev-notice"><strong>Mode développement</strong><span>Après la demande, entrez 6 chiffres au choix, par exemple <b>234567</b>. Aucun SMS n’est envoyé.</span></div>{% endif %}
<p class="auth-error" data-auth-error role="alert" hidden></p><p class="auth-status" data-auth-status role="status" hidden></p>
<noscript><p>Activez JavaScript pour vous connecter.</p><style>[data-auth] form{display:none}</style></noscript>
<form data-auth-phone><label for="telephone">Numéro de téléphone</label><input id="telephone" name="telephone" type="tel" autocomplete="tel" placeholder="+243 970 000 000" pattern="\+[0-9 ()-]{7,20}" title="Indiquez votre numéro avec son indicatif international." required><small>Avec l’indicatif du pays, par exemple +243.</small><button class="button full" type="submit">Continuer <span>→</span></button><p class="form-note">Un code à usage unique permet de vérifier votre numéro.</p></form>
<form data-auth-code hidden><label for="code">Code de vérification</label><input id="code" name="code" class="otp-input" type="text" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" placeholder="000000" required><small>Code valable 10 minutes, utilisable une seule fois.</small><button class="button full" type="submit">Vérifier mon code <span>→</span></button><div class="otp-actions"><button type="button" class="text-link" data-auth-change>Modifier le numéro</button><button type="button" class="text-link" data-auth-resend>Renvoyer le code</button></div></form>
<form data-auth-profile hidden><label for="nom">Votre nom complet</label><input id="nom" name="nom" autocomplete="name" minlength="2" maxlength="120" placeholder="Votre nom et prénom" required><label for="parrain">Code parrain <span class="optional">(facultatif)</span></label><input id="parrain" name="codeParrain" maxlength="12" placeholder="Votre code de parrainage"><label class="consent"><input type="checkbox" required><span>J’ai pris connaissance de la <a href="{{ app.request.baseUrl }}/confidentialite">politique de confidentialité</a>.</span></label><button class="button full" type="submit">Créer mon espace <span>↗</span></button></form>
<div class="auth-bottom">{{ inscription ? 'Déjà membre ?' : 'Vous découvrez CarnetDeLoyer ?' }} <a href="{{ path(inscription ? 'site_connexion' : 'site_inscription') }}">{{ inscription ? 'Se connecter' : 'Créer un compte' }}</a></div><a class="text-link block-link" href="{{ path('site_demonstration') }}">Explorer la démo sans compte →</a></div></section>
{% endblock %}
